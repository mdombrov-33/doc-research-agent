# OpenAI - used for embeddings only (text-embedding-3-small)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter - used for all chat/LLM calls
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override default model (anthropic/claude-sonnet-latest)
# LLM_MODEL=anthropic/claude-sonnet-latest

# Qdrant: set QDRANT_MODE to "local" or "cloud"
QDRANT_MODE=cloud
QDRANT_LOCAL_URL=http://localhost:6333
QDRANT_CLOUD_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=documents

# Embedding
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# App
APP_ENV=development
LOG_LEVEL=INFO
UPLOAD_DIR=./uploads
API_URL=http://localhost:8000
