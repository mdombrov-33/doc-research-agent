# ── Secrets (required) ──
# OpenAI — embeddings (text-embedding-3-small) only.
# The eval CI needs this too, for embeddings: ingesting the corpus + the separation check.
OPENAI_API_KEY=your_openai_api_key_here
# OpenRouter — all chat/LLM calls (the agent's reasoning + answer, grading, and the eval judges).
# Guardrails run locally (llm-guard) and need no API key.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Qdrant (required) ──
# QDRANT_MODE is "local" or "cloud"; cloud needs the URL + API key.
QDRANT_MODE=cloud
QDRANT_LOCAL_URL=http://localhost:6333
QDRANT_CLOUD_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=documents

# ── App (required) ──
APP_ENV=development
LOG_LEVEL=INFO
# Where the Streamlit UI reaches the backend.
API_URL=http://localhost:8000

# ── Optional overrides (defaults live in src/config.py) ──
# LLM_MODEL=anthropic/claude-sonnet-4.6
# CLASSIFIER_MODEL=openai/gpt-5.4-mini
# LLM_MAX_RETRIES=3
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# UPLOAD_DIR=./uploads
# MAX_UPLOAD_BYTES=26214400
# UPLOAD_READ_CHUNK_BYTES=1048576
# MAX_PDF_PAGES=200
# MAX_EXTRACTED_CHARACTERS=1000000
# MAX_CHUNKS_PER_DOCUMENT=1000
# DATA_DIR=./data   # home for local SQLite telemetry and checkpoint databases
# CHECKPOINT_BACKEND=sqlite  # optional: postgres with DATABASE_URL
# METRICS_BACKEND=sqlite  # optional: postgres with DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/database
# Cross-encoder reranking
# RERANK_ENABLED=true
# RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_MULTIPLIER=4
# RERANK_FETCH_CAP=100
# Per-IP rate limiting on /stream and /upload (slowapi)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT=30/minute
# RATE_LIMIT_STORAGE_URI=memory:// 

# ── Build metadata (CI/Docker) ──
# Stamped on every log line. Baked into the image via --build-arg (see Dockerfile).
# Unset locally is fine — logs show git_sha=unknown / version=unknown.
# GIT_SHA=
# APP_VERSION=
